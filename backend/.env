# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/farmsocial
MONGODB_URI=mongodb://127.0.0.1:27017/farmsocial

# JWT Secret for token authentication
JWT_SECRET=farmsocial_jwt_secret_key_2024_v1_super_secure_key_change_in_production

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email Configuration (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@farmsocial.com

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1-your-twilio-number

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-public
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxxx

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Session Configuration
SESSION_SECRET=session_secret_key_change_in_production
SESSION_TIMEOUT=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Service (Flask)
AI_SERVICE_URL=http://localhost:5001

# Database Backup
DB_BACKUP_ENABLED=false
DB_BACKUP_INTERVAL=86400000