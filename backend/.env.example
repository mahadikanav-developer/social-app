# ========================================
# FarmSocial Backend Environment Configuration
# ========================================
# This file contains all environment variables needed for the backend

# ========== SERVER CONFIGURATION ==========
NODE_ENV=development
PORT=5000
HOST=localhost

# ========== DATABASE ==========
MONGODB_URI=mongodb://localhost:27017/farmsocial
MONGODB_USER=farmsocial
MONGODB_PASSWORD=your-secure-password-here
# For Atlas (cloud): mongodb+srv://user:password@cluster.mongodb.net/farmsocial

# ========== AUTHENTICATION & SECURITY ==========
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRE=90d

# ========== SECURITY SETTINGS ==========
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
TWO_FA_TIMEOUT_MINUTES=5
TWO_FA_MAX_ATTEMPTS=3
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT=5
OTP_RATE_LIMIT_WINDOW=3600000

# ========== SESSION MANAGEMENT ==========
SESSION_TIMEOUT_MINUTES=1440
SESSION_REFRESH_BEFORE_EXPIRE_MINUTES=60
DEVICE_SESSION_MAX_AGE_DAYS=30

# ========== CORS CONFIGURATION ==========
ALLOWED_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://farmsocial.com
CORS_CREDENTIALS=true

# ========== EMAIL CONFIGURATION (OTP & NOTIFICATIONS) ==========
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@farmsocial.com
EMAIL_FROM_NAME=FarmSocial

# ========== SMS CONFIGURATION (OTP) ==========
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ========== FILE UPLOAD ==========
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,mp4,mov,avi
UPLOAD_DIR=./uploads
CLOUD_STORAGE=local

# Cloud storage options (if not using local):
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ========== PAYMENT GATEWAY ==========
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYMENT_CURRENCY=USD

# ========== LOGGING & MONITORING ==========
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=./logs/farmsocial.log
SENTRY_DSN=

# ========== AI & ML SERVICE ==========
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_ENABLED=true
AI_API_KEY=

# ========== EXTERNAL SERVICES ==========
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
WEATHER_API_KEY=

# ========== TWO-FACTOR AUTHENTICATION ==========
TOTP_WINDOW=1
TOTP_STEP=30

# ========== DATA RETENTION & COMPLIANCE ==========
DELETE_EXPIRED_OTP_DAYS=1
DELETE_EXPIRED_SESSIONS_DAYS=60
USER_DATA_EXPORT_ENABLED=true
USER_ACCOUNT_DELETION_GRACE_PERIOD_DAYS=30

# ========== FEATURE FLAGS ==========
FEATURE_2FA_ENABLED=true
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_LIVE_STREAMING_ENABLED=true
FEATURE_GROUPS_ENABLED=true
FEATURE_COMMUNITIES_ENABLED=true
FEATURE_EVENTS_ENABLED=true

# ========== ADMIN SETTINGS ==========
ADMIN_EMAIL=admin@farmsocial.com
ADMIN_PHONE=+1234567890
SUPPORT_EMAIL=support@farmsocial.com

# ========== CACHE CONFIGURATION ==========
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
ENABLE_CACHE=false

# ========== VERSION ==========
APP_VERSION=1.0.0
BUILD_DATE=2026-04-19
